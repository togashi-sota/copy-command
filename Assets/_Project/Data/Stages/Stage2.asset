  buttonLabel: 2
  isTestStage: 0
  tutorialText: "\u3042\u306A\u305F\u306E\u547D\u4EE4\u306F\u3001\u6B21\u306E ENEMY TURN \u306B\u6575\u304C\u305D\u306E\u307E\u307E\u4F7F\u3046\uFF08\u30AB\u30FC\u30C9\u30FB\u65B9\u5411\u30FB\u8DDD\u96E2\u307E\u3067\u540C\u3058\u3002\u7A81\u9032\u306A\u3089\u6575\u30823\u30DE\u30B9\uFF09\u3002\n\u9EC4\u8272\u306E\u30C8\u30B2\u306F\u3001\u5165\u308B\u305F\u3073\u306B5\u30C0\u30E1\u30FC\u30B8\u3002\u6575\u304C\u5165\u3063\u3066\u3082\u540C\u3058\u3002\n\u6575\u306E\u901A\u308A\u9053\u306B\u30C8\u30B2\u304C\u3042\u308B\u306A\u3089\u2026\uFF1F \u6575\u306B\u300C\u7A81\u9032\u300D\u3092\u4F7F\u308F\u305B\u3066\u3001\u81EA\u5206\u304B\u3089\u30C8\u30B2\u3078\u7A81\u3063\u8FBC\u307E\u305B\u3088\u3046\uFF08\u6700\u59272\u547D\u4EE4\uFF09\u3002"
  hintAfterFirstTurn: "\u6575\u306F\u3001\u3042\u306A\u305F\u3068\u540C\u3058\u547D\u4EE4\u3092\u300C\u6575\u306E\u4F4D\u7F6E\u304B\u3089\u300D\u4F7F\u3046\u3002\u3042\u306A\u305F\u306E\u901A\u308A\u9053\u306F\u5B89\u5168\u3067\u3082\u3001\u6575\u306E\u901A\u308A\u9053\u306B\u306F\u30C8\u30B2\u304C\u3042\u308B\u3053\u3068\u304C\u3042\u308B\u3002\n\u76E4\u9762\u306E\u7AEF\u3067\u306F\u3001\u3042\u306A\u305F\u306F\u6B62\u307E\u3063\u3066\u3082\u3001\u6575\u306F\u540C\u3058\u547D\u4EE4\u3067\u52D5\u3051\u308B\u3053\u3068\u304C\u3042\u308B\u3002\u3053\u306E\u30BA\u30EC\u3082\u4F7F\u3048\u308B\u3002"
